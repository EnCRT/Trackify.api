# =============================================================================
# Trackify.API — Environment Variables
# =============================================================================
# Copy this to .env and fill in real values.
# .env is git-ignored — never commit secrets!
# =============================================================================

# ---- Server ----
HOST=0.0.0.0
PORT=1337

# ---- Secrets (generate with: openssl rand -base64 32) ----
APP_KEYS="change_me_1,change_me_2,change_me_3,change_me_4"
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
ENCRYPTION_KEY=change_me

# =============================================================================
# DATABASE — choose one mode
# =============================================================================

# ---- Local dev: SQLite (no external deps) ----
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# ---- Local dev: PostgreSQL via Docker Compose ----
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trackify
DATABASE_USERNAME=trackify
DATABASE_PASSWORD=trackify_dev
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# ---- Production: Supabase PostgreSQL (Render / Railway / VPS) ----
# Set DATABASE_URL to your Supabase connection string.
# Get it from: Supabase Dashboard → Settings → Database → Connection string → URI
#
# Session Pooler (PgBouncer, port 6543) — recommended for serverless/Strapi:
#   postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#   Requires: DATABASE_POOL_MAX=1
#
# Direct Connection (port 5432) — no PgBouncer limitations:
#   postgresql://postgres.[REF]:[PASS]@db.[REF].supabase.co:5432/postgres
#   Requires: DATABASE_SSL=true, DATABASE_SSL_REJECT_UNAUTHORIZED=false
#
# DATABASE_URL=postgresql://postgres.[REF]:[PASS]@db.[REF].supabase.co:5432/postgres
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# =============================================================================
# Optional: External Services
# =============================================================================
# GOOGLE_CLIENT_ID for mobile auth (Web application OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Supabase Auth (only needed if Strapi calls Supabase Admin API)
# Get from: Supabase Dashboard → Settings → API
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

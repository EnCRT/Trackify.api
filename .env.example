# =============================================================================
# Trackify.API — Environment Variables
# =============================================================================
# Copy this to .env and fill in real values.
# .env is git-ignored — never commit secrets!
# =============================================================================

# ---- Server ----
HOST=0.0.0.0
PORT=1337

# ---- Secrets (generate with: openssl rand -base64 32) ----
APP_KEYS="change_me_1,change_me_2,change_me_3,change_me_4"
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
ENCRYPTION_KEY=change_me

# =============================================================================
# DATABASE — choose one mode
# =============================================================================

# ---- Local dev: SQLite (no external deps) ----
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# ---- Local dev: PostgreSQL via Docker Compose (recommended) ----
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trackify
DATABASE_USERNAME=trackify
DATABASE_PASSWORD=trackify_dev
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# ---- Production: Railway / Render / VPS ----
# Railway auto-provides DATABASE_URL — Strapi uses it automatically.
# Just uncomment the line below and comment out the block above:
# DATABASE_URL=postgresql://user:password@host:5432/trackify

# =============================================================================
# Optional: External Services
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

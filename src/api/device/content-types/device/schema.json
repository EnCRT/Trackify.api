{
  "kind": "collectionType",
  "collectionName": "devices",
  "info": {
    "singularName": "device",
    "pluralName": "devices",
    "displayName": "Device",
    "description": "GNSS-логгер (ESP32-трекер) пилота. Идентифицируется неизменяемым serial_number."
  },
  "options": {
    "draftAndPublish": false,
    "comment": "B-05: firmware/serial fields; `tracks` relation → `rides`. K-02: dropped device_identifier/settings_json/last_battery_percent/last_sync_at/paired_at (unused telemetry)."
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "serial_number": {
      "type": "string",
      "unique": true,
      "maxLength": 100
    },
    "model": {
      "type": "string",
      "maxLength": 100
    },
    "hardware_revision": {
      "type": "string",
      "maxLength": 50
    },
    "firmware_version": {
      "type": "string",
      "maxLength": 50
    },
    "mac_address": {
      "type": "string",
      "maxLength": 32
    },
    "default_sample_rate_hz": {
      "type": "integer",
      "default": 25
    },
    "last_seen_at": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "rides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ride.ride",
      "mappedBy": "device"
    },
    "sync_sessions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sync-session.sync-session",
      "mappedBy": "device"
    }
  }
}

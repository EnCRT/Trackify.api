{
  "kind": "collectionType",
  "collectionName": "devices",
  "info": {
    "singularName": "device",
    "pluralName": "devices",
    "displayName": "Device",
    "description": "Устройство для записи треков (GPS-трекер, телефон)"
  },
  "options": {
    "draftAndPublish": false,
    "comment": ""
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "device_identifier": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "model": {
      "type": "string",
      "maxLength": 100
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "tracks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::track.track",
      "mappedBy": "device"
    },
    "sync_sessions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sync-session.sync-session",
      "mappedBy": "device"
    }
  }
}

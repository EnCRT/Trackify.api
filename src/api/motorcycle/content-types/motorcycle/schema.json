{
  "kind": "collectionType",
  "collectionName": "motorcycles",
  "info": {
    "singularName": "motorcycle",
    "pluralName": "motorcycles",
    "displayName": "Motorcycle",
    "description": "Транспорт в гараже пилота (мото/авто/велосипед/скутер/дрон). Всегда принадлежит пользователю."
  },
  "options": {
    "draftAndPublish": false,
    "comment": "B-04: added user relation (required), kind, garage fields, rides inverse."
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "kind": {
      "type": "enumeration",
      "enum": ["moto", "car", "bicycle", "scooter", "drone", "other"],
      "default": "moto",
      "required": true
    },
    "brand": {
      "type": "string",
      "maxLength": 100
    },
    "model": {
      "type": "string",
      "maxLength": 100
    },
    "year": {
      "type": "integer",
      "min": 1900,
      "max": 2100
    },
    "engine_cc": {
      "type": "integer",
      "min": 1,
      "max": 3000
    },
    "displacement_cc": {
      "type": "integer",
      "min": 1
    },
    "power_hp": {
      "type": "integer",
      "min": 0
    },
    "weight_kg": {
      "type": "integer",
      "min": 0
    },
    "tire_front": {
      "type": "string",
      "maxLength": 50
    },
    "tire_rear": {
      "type": "string",
      "maxLength": 50
    },
    "color": {
      "type": "string",
      "maxLength": 50
    },
    "license_plate": {
      "type": "string",
      "maxLength": 20
    },
    "vin": {
      "type": "string",
      "maxLength": 20,
      "private": true
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "purchased_at": {
      "type": "date"
    },
    "sold_at": {
      "type": "date"
    },
    "odometer_km": {
      "type": "integer",
      "min": 0
    },
    "service_notes": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "photos": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": true
    },
    "deleted_at": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "rides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ride.ride",
      "mappedBy": "vehicle"
    }
  }
}

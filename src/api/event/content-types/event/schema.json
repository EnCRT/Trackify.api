{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Трек-день / организованный заезд на трассе с участниками."
  },
  "options": {
    "draftAndPublish": true,
    "comment": "B-08: `track` relation → `circuit`; added organizer, participants, heats, location, cover_image, entry_fee, weather. `results` are derivable from heats→rides (ranked by Ride.best_lap_ms), not stored as a relation."
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "status": {
      "type": "enumeration",
      "enum": ["planned", "active", "completed", "cancelled"],
      "default": "planned",
      "required": true
    },
    "max_participants": {
      "type": "integer",
      "min": 1
    },
    "entry_fee": {
      "type": "decimal"
    },
    "location_lat": {
      "type": "float"
    },
    "location_lon": {
      "type": "float"
    },
    "weather": {
      "type": "json"
    },
    "cover_image": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "circuit": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::circuit.circuit",
      "inversedBy": "events"
    },
    "organizer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "participants": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "heats": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ride.ride",
      "mappedBy": "event"
    }
  }
}

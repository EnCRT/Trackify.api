{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Трек-день / заезд"
  },
  "options": {
    "draftAndPublish": true,
    "comment": ""
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "track": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::track.track",
      "inversedBy": "events"
    },
    "status": {
      "type": "enumeration",
      "enum": ["planned", "active", "completed", "cancelled"],
      "default": "planned",
      "required": true
    },
    "max_participants": {
      "type": "integer",
      "min": 1
    }
  }
}
